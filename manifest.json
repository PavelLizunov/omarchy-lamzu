{
  "schemaVersion": 1,
  "id": "slovn.lamzu",
  "name": "LAMZU THORN",
  "version": "2.0.0",
  "author": "PavelLizunov",
  "license": "MIT",
  "description": "LAMZU THORN battery, button profiles, shortcuts and pointer settings, adapted from MX Ergo.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "LAMZU THORN",
    "description": "Button profiles, pointer controls and USB/wireless telemetry",
    "category": "Hardware",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "locale": "system",
      "hideWhenDisconnected": false
    },
    "schema": [
      {
        "key": "locale",
        "type": "string",
        "label": "Interface language",
        "defaultValue": "system"
      },
      {
        "key": "hideWhenDisconnected",
        "type": "boolean",
        "label": "Hide when disconnected",
        "defaultValue": false
      }
    ]
  }
}
